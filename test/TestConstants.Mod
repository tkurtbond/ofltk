MODULE TestConstants; (* ofltk's constants are FLTK's *)

(* Written by tools/gen-constants.py: one check per constant, against the
   value the installed FLTK's headers give (CConstants). A failure means
   FLTK's headers changed: run the script again, and see what moved. *)

IMPORT SYSTEM, Out, Fl, FlDraw, Check, CConstants;

VAR checked, wrong: INTEGER;

PROCEDURE Same(oberon: INTEGER; c-: ARRAY OF CHAR);
  VAR v: INTEGER;
BEGIN
  INC(checked);
  IF ~CConstants.Value(c, v) OR (v # oberon) THEN
    INC(wrong); Out.String("  differs from C: "); Out.String(c); Out.Ln
  END
END Same;

BEGIN
  checked := 0; wrong := 0;
  Same(Fl.EvNone, "FL_NO_EVENT");
  Same(Fl.EvPush, "FL_PUSH");
  Same(Fl.EvRelease, "FL_RELEASE");
  Same(Fl.EvEnter, "FL_ENTER");
  Same(Fl.EvLeave, "FL_LEAVE");
