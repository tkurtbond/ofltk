  Same(SYSTEM.VAL(INTEGER, Fl.WhenEnterKey), "FL_WHEN_ENTER_KEY");
  Same(SYSTEM.VAL(INTEGER, Fl.WhenEnterKeyAlways), "FL_WHEN_ENTER_KEY_ALWAYS");
  Same(SYSTEM.VAL(INTEGER, Fl.WhenEnterKeyChanged), "FL_WHEN_ENTER_KEY_CHANGED");
