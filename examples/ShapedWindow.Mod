  t[108] := "+$;$&++%'$,++.+%+,,=$'+++,*%,;+*;,%$,%+&*%++&-;%$$.%;!.$$%#,+=$$%,!#@#;;+.%*=+#.,,.+%+.$+++%%,%.#>.;";
  t[109] := "*$,%%+%$%$%#;+,;#%%$;+,+%$%$%++&%&;;%;$&$*&;;%;,$%%++;+.%+$$%%$$%,+#.%.@.%;$++*>#+,;.&$@.!#='&@+@@..";
  t[110] := "%$;..%-%%*,;+,,%$$$.!+'$%%%$;+%%+.+++*+;$%;%,%;,;$%+=$#+,%&''++,.+$#.!+%%+;*%.!++*%+.',.%;!;.#.;#@+%";
  t[111] := "%;,%%+%*'*&%!.'*$%$$'..++%,;$%%++;&+,%%%$%,,..++&&*$$,,;;$$$$++#.$+%.@%;..%+.;#+&,.+*.;..$&,!.;+;..*";
  t[112] := "%%;$-%%+$$-%+$,.+;&)'%;.!#,%%%++,%$%';,$%%.+%,#+&+'&$,,+*%+%%..+;#.+#$%+.+.,+;%$.%+*$++,.%++#@#$'$.!";
  t[113] := ".&=$+&&%,%#%*,;*;*=&'$;+.##,,+.$+,*-'%%+,;.;$'%%,,'%,%*$%%%,,..;;..,+.+,%+,+,,*,#+&%%#.#.!.;@!%%...%";
  t[114] := "%-$+'%.$-+%%%&%$-**=&$%%.;%+#.;$%.$;+%,%,;;%;*$%;=.+,$--&$,+$&..#+%,%,$!+%++,+.%+%%$+%!#!##+++*$,@!#";
  t[115] := ".#+=+@#&$-*,..'-*;-$$;$=';,++#@%%$+@+%%%$$,+&&+;$#,;&===*;%*,=,#+##%).*%>#%+$#,*=.+%$+.$#.$+@%;*%+#.";
  t[116] := "#$&+.$;%%-&;.;&;-;$$=$*-$,.,;;.#!.,.,$%,,,%&*;%;..;'=$+$;;)%=,%+..%+#,,%&$+#,.;$$.,+#;#+,$%##;;;%&+;";
  t[117] := ";+.>.;&%=+*,+&,%;*;%%'-$++%.%,.%%+&$;%%,%.%=.=*%%**)=)&%.#'-&,+%%#;;+>.$,+.*%#+!,,&,@;,,,.@=%&';,+.,";
  ASSERT(FlImages.OpenXPM(i, t, 118))
END Tile;

BEGIN
  dim := 200;
  NEW(win); Fl.OpenDoubleWindowAt(win, 100, 100, dim, dim, "Testing1");
  NEW(img); PrepareShape(dim, img);
  FlImages.SetShape(win, img);
  NEW(box); Fl.OpenBox(box, 0, 0, win.W(), win.H(), "");
  NEW(pxm); Tile(pxm);
  NEW(tiled); FlImages.OpenTiled(tiled, pxm, 0, 0);
  FlImages.SetImage(box, tiled); tiled.Close;  (* the box keeps it *)
  NEW(g); Fl.OpenGroup(g, 10, 20, 80, 20, "");
  g.SetBoxType(Fl.NoBox);
  NEW(b); FlButtons.OpenButton(b, 10, 20, 80, 20, "Close");
  b.action := Close;
  g.End;
  g.SetResizable(NIL);
  NEW(g); Fl.OpenGroup(g, 60, 70, 80, 40, "Drag me");
  g.SetBoxType(Fl.NoBox);
  g.SetAlign(Fl.AlignTop);
  NEW(bs); FlButtons.OpenButton(bs, 60, 70, 80, 20, "Shrink");
  bs.action := Shrink;
  bs.Deactivate;
  NEW(be); FlButtons.OpenButton(be, 60, 90, 80, 20, "Enlarge");
  be.action := Enlarge;
  g.End;
  g.SetResizable(NIL);
  win.End;
  win.SetResizable(win);
  win.ShowArgs;
  Fl.Run;
  win.Delete; pxm.Close; img.Close
END ShapedWindow.
