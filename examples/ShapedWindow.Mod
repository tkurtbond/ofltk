MODULE ShapedWindow; (* FLTK's examples/shapedwindow.cxx: a round window with a hole, moved by dragging it *)

IMPORT Fl, FlDraw, FlButtons, FlImages;

CONST
  factor = 1.3;  (* a REAL, as the C++ float *)

TYPE
  (* Moves its window as it is dragged. *)
  DragBox = POINTER TO RECORD (Fl.BoxDesc) END;

VAR
  dim, fromx, fromy, winx, winy: INTEGER;
  win: Fl.DoubleWindow;
  img, pxm, tiled: FlImages.Image;
  box: DragBox;
  g: Fl.Group;
  b, bs, be: FlButtons.Button;

PROCEDURE (d: DragBox) Handle*(event: INTEGER): BOOLEAN;
BEGIN
  IF event = Fl.EvPush THEN
    fromx := Fl.EventXRoot(); fromy := Fl.EventYRoot();
    winx := win.X(); winy := win.Y();  (* a top-level window's place on the screen *)
    RETURN TRUE
  ELSIF event = Fl.EvDrag THEN
    win.Position(winx + Fl.EventXRoot() - fromx, winy + Fl.EventYRoot() - fromy);
    RETURN TRUE
  END;
  RETURN d.Handle^(event)
END Handle;

PROCEDURE Close(w: Fl.Widget);
BEGIN win.Hide
END Close;

PROCEDURE Shrink(w: Fl.Widget);
  VAR old: INTEGER;
BEGIN
  old := win.W();
  win.Size(SHORT(ENTIER(old / factor)), SHORT(ENTIER(old / factor)));
  IF win.W() <= dim THEN w.Deactivate END
END Shrink;

PROCEDURE Enlarge(w: Fl.Widget);
  VAR old: INTEGER;
BEGIN
  old := win.W();
  win.Size(SHORT(ENTIER(old * factor)), SHORT(ENTIER(old * factor)));
  bs.Activate
END Enlarge;

(* img: a white circle with a hole in it, on black. *)
PROCEDURE PrepareShape(w: INTEGER; img: FlImages.Image);
  VAR surf: FlImages.Surface;
BEGIN
  NEW(surf); FlImages.OpenSurface(surf, w, w);
  surf.Begin;
  FlDraw.SetColor(Fl.Black); FlDraw.RectF(-1, -1, w + 2, w + 2);
  FlDraw.SetColor(Fl.White); FlDraw.Pie(2, 2, w - 4, w - 4, 0.0D0, 360.0D0);
  FlDraw.SetColor(Fl.Black); FlDraw.Pie(SHORT(ENTIER(0.7D0 * w)), w DIV 2, w DIV 4, w DIV 4, 0.0D0, 360.0D0);
  surf.End;
  surf.GetImage(img); surf.Close
END PrepareShape;

(* FLTK's test/pixmaps/tile.xpm. *)
PROCEDURE Tile(i: FlImages.Image);
  VAR t: ARRAY 118, 101 OF CHAR;
BEGIN
  t[0] := "100 100 17 1";
  t[1] := "  c None";
  t[2] := ". c #DCDCDC";
  t[3] := "+ c #D9D9D9";
  t[4] := "@ c #E4E4E4";
  t[5] := "# c #DFDFDF";
  t[6] := "$ c #CECECE";
  t[7] := "% c #D2D2D2";
  t[8] := "& c #C8C8C8";
  t[9] := "* c #CACACA";
  t[10] := "= c #C4C4C4";
  t[11] := "- c #BEBEBE";
  t[12] := "; c #D4D4D4";
  t[13] := "> c #E8E8E8";
  t[14] := ", c #D6D6D6";
  t[15] := "' c #C6C6C6";
  t[16] := ") c #B2B2B2";
  t[17] := "! c #E2E2E2";
  t[18] := ".+@.##$%%$$$&*=..%$*%-;*>,%$%#>,$,%%*%*.#*%++$;+,,.&&=-%%+.$,#,=;%#,@.+,%>,+=-++@@#%$.++#,--;.=*+,,>";
  t[19] := "%%.&$@.#,*%*&'%%&$;,*%%,&%;%,#..;$$%';+.+,++.%.;+@@@$'.;'..;@.+$%)&!!,.!>+%@%-*%@>#.+&&+.+$%,++$$#++";
